<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiApp_001.vistas.DemoBindingListaMesasV"
             Title="DemoBindingListaMesasV">
    <VerticalStackLayout>
        <Label Text="LISTA DE MESAS"
               FontAttributes="Bold"
               FontSize="22"
               HorizontalOptions="Center"
               />
        <Button Text="Cargar Mesas"
                HorizontalOptions="Center"
                Command="{Binding CargarMesasDTOCommand}"
                />
        <CollectionView ItemsSource="{Binding ListaDeMesasDTO}" >
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span ="2"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1"
                            Stroke="LightGray" Padding="15"
                            Margin="0,5"
                            BackgroundColor="{Binding NombreColor}">
                        
                            <StackLayout>
                                <Label Text="{Binding NumeroMesa}"/>
                                <Label Text="{Binding EstadoMesa}"/>
                                <Label Text="{Binding Capacidad}"/>
                            </StackLayout>
                        </Border>
                             
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>